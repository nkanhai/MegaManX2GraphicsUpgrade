# Generated recompiler output — ROM-derived, never committed.
/src/gen/*
!/src/gen/.gitkeep
/recomp/funcs.h

# ROM images and anything derived from them.
*.sfc
*.smc
*.srm
/saves/

# Cx4 internal data ROM (HG51B S169 reciprocal/sqrt/trig table). Capcom/Hitachi
# firmware, user-supplied, 3072 bytes. All three names are the same blob.
cx4.rom
cx4.data.rom
hg51bs169.data.rom

# Build trees
/build*/
/release*/
CMakeFiles/
CMakeCache.txt

# Local runtime state
/rom.cfg
/config.ini
/*.log
/_*.log
/_*.png
/_*.bmp
/host_report*.json
/*.dmp
tools/__pycache__/
/_diz_baseline_cfg/

# Shared desktop host local preferences and reports
/config.local.ini
/keybinds.ini
/tier2_*.json

# Player diagnostics
/logs/
/last_run_report.json
/replay-divergence.sav

# HD-2D local inputs / captures (synthetic sources live under hd2d/fixtures).
*.rom
*.sav
*.state
*.replay
*.replay.*
*.snesmod
/exports/
/captures/
*.o
# Wavefront .obj meshes are source assets; compiler outputs belong in build trees.
